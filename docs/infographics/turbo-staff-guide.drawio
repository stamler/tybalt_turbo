        <mxCell id="107" value="Use the full commitment" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#213547;fontStyle=1;" vertex="1" parent="1">
