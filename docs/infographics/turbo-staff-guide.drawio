        <mxCell id="119" value="$0 means no authority in that category.&#10;Access needs report permission.&#10;Ask your approver if unavailable." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526579;fontStyle=0;" vertex="1" parent="1">
