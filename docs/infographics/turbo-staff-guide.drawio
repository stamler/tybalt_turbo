        </mxCell>
        <mxCell id="101" value="With a job → PO at any amount.&#10;Without a job → PO at or above&#10;the configured no-PO limit." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#213547;fontStyle=0;" vertex="1" parent="1">
