        </mxCell>
        <mxCell id="108" value="One-Time / Cumulative: full PO total.&#10;Recurring: amount × all occurrences.&#10;Approval checks use CAD." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#213547;fontStyle=0;" vertex="1" parent="1">
