        </mxCell>
        <mxCell id="103" value="IF THE LIMIT IS $100 CAD" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#285EA8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="106" y="1730" width="388" height="31.799999999999997" />
        </mxCell>
        <mxCell id="104" value="$99.99: no PO  ·  $100: PO" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=24;fontColor=#213547;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="106" y="1761" width="388" height="41.599999999999994" />
        </mxCell>
        <mxCell id="105" value="$100 is the software default.&#10;Confirm the live setting before use.&#10;See the exceptions below." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526579;fontStyle=0;" vertex="1" parent="1">
