        </mxCell>
        <mxCell id="124" value="A job links time, expenses and POs to the same project. A corporate card is a payment type, not an approval exemption." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#213547;fontStyle=0;" vertex="1" parent="1">
