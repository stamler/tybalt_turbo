        </mxCell>
        <mxCell id="121" value="Mileage, Fuel Card, Allowance and enabled Personal Reimbursement entries do not require a PO." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#213547;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="2041" width="1400" height="38.8" />
        </mxCell>
        <mxCell id="122" value="Payables administrators can bypass the amount limit for On Account entries; the job rule still applies." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#213547;fontStyle=0;" vertex="1" parent="1">
