        <mxCell id="111" value="$500 × 12 = $6,000 CAD" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=26;fontColor=#213547;fontStyle=1;" vertex="1" parent="1">
