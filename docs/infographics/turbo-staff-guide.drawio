        <mxCell id="112" value="Second approval applies above a&#10;positive category threshold. At the&#10;threshold, one step is enough." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#526579;fontStyle=0;" vertex="1" parent="1">
